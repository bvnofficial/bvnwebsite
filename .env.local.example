# BVN Contact Form Email Configuration
# Copy this file to .env.local and fill in your credentials

# ── Option 1: SMTP (Gmail, Outlook, SendGrid, etc.) ────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Option 2: Resend API (easiest, free tier available) ─────────
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# For Gmail: use an App Password (not your main password)
# https://support.google.com/accounts/answer/185833
